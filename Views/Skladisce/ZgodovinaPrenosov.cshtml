@model List<E_Gostinc.Models.PrenosMedSkladisci>
@{
    ViewData["Title"] = "Zgodovina prenosov";
}

<div class="container-fluid mt-4">
    <h2 class="mb-4">Zgodovina prenosov med skladišči</h2>
    
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Datum</th>
                            <th>Iz skladišča</th>
                            <th>V skladišče</th>
                            <th>Artikel</th>
                            <th class="text-end">Količina</th>
                            <th>Uporabnik</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var prenos in Model)
                    {
                        <tr>
                            <td>@prenos.Datum.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="badge bg-danger">@prenos.IzSkladisca.Naziv</span></td>
                            <td><span class="badge bg-success">@prenos.VSkladisce.Naziv</span></td>
                            <td>@prenos.DobavniArtikel.Naziv</td>
                            <td class="text-end"><strong>@prenos.Kolicina</strong></td>
                            <td>@prenos.Uporabnik.UserName</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Ni še bilo nobenih prenosov.
                </div>
            }
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-action="PrenosMedSkladisci" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nov prenos
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Nazaj na pregled
        </a>
    </div>
</div>