@{
    ViewData["Title"] = "Blagajna";
    var racunViewModel = ViewBag.RacunViewModel as E_Gostinc.Models.RacunViewModel;
}

<div class="container-fluid mt-4">
    <!-- Error/Success sporočila -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Napaka!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    
    <nav class="navbar navbar-expand-lg bg-light shadow-sm rounded-3 mb-4">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarScroll">
                <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll">
                    @foreach (var vrsta in ViewBag.Vrste)
                    {
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index" asp-route-vrstaId="@vrsta.ID">
                                @vrsta.Naziv
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="row">
        <div class="col-lg-8 col-md-7 order-1 order-lg-1 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    Artikli
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var artikel in ViewBag.Artikli)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <form asp-controller="Home" asp-action="DodajNaRacun" method="post">
                                    <input type="hidden" name="artikelId" value="@artikel.ID" />
                                    <input type="hidden" name="vrstaId" value="@artikel.VrstaID" />
                                    <button type="submit" class="btn btn-outline-secondary py-3 rounded-3 shadow-sm w-100">
                                        <div class="fw-bold text-truncate">@artikel.Naziv</div>
                                        <small class="text-muted">@artikel.Cena_brez_ddv €</small>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-5 order-2 order-lg-2">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-success text-white fw-bold text-center">
                     Račun
                </div>
                <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                    @if (racunViewModel != null && racunViewModel.Artikli.Any())
                    {
                        <table class="table table-sm table-hover">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Artikel</th>
                                    <th class="text-center">Kol.</th>
                                    <th class="text-end">Cena</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in racunViewModel.Artikli)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.Naziv</strong>
                                            <br />
                                            <small class="text-muted">@item.Cena_z_ddv € / kom</small>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span class="badge bg-secondary">@item.Kolicina</span>
                                        </td>
                                        <td class="text-end align-middle">
                                            <strong>@item.Skupaj_z_ddv €</strong>
                                        </td>
                                        <td class="text-end align-middle">
                                            <form asp-controller="Home" asp-action="OdstraniIzRacuna" method="post" class="d-inline">
                                                <input type="hidden" name="artikelId" value="@item.ArtikelId" />
                                                <input type="hidden" name="vrstaId" value="@item.VrstaID" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Odstrani">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <hr />
                        
                        
                        <div class="d-flex justify-content-between fs-4 fw-bold text-success border-top pt-2">
                            <span>SKUPAJ:</span>
                            <span>@racunViewModel.SkupajZDdv €</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted my-5">
                            <p class="mt-3">Račun je prazen.</p>
                        </div>
                    }
                </div>

                <div class="card-footer bg-white">
                    <div class="d-grid gap-2">
                        <form asp-controller="Home" asp-action="ZakljuciRacun" method="post">
                            <button type="submit" class="btn btn-success btn-lg w-100" 
                                    @(racunViewModel == null || !racunViewModel.Artikli.Any() ? "disabled" : "")>
                                 Zaključi račun
                            </button>
                        </form>
                        <form asp-controller="Home" asp-action="Ponastavi" method="post">
                            <button type="submit" class="btn btn-outline-secondary w-100"
                                    @(racunViewModel == null || !racunViewModel.Artikli.Any() ? "disabled" : "")>
                                 Ponastavi
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>